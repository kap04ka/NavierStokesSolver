.PHONY : tests/test_obstacle.cpp.o

tests/test_obstacle.i: tests/test_obstacle.cpp.i
.PHONY : tests/test_obstacle.i

# target to preprocess a source file
tests/test_obstacle.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_obstacle.dir/build.make CMakeFiles/test_obstacle.dir/tests/test_obstacle.cpp.i
.PHONY : tests/test_obstacle.cpp.i

tests/test_obstacle.s: tests/test_obstacle.cpp.s
.PHONY : tests/test_obstacle.s

# target to generate assembly for a file
tests/test_obstacle.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_obstacle.dir/build.make CMakeFiles/test_obstacle.dir/tests/test_obstacle.cpp.s
.PHONY : tests/test_obstacle.cpp.s

